# Optional. With a YouTube Data API v3 key, the backend looks up a full-length YouTube
# video for songs that otherwise only have a 30-second preview or the JioSaavn album widget.
# Results are cached in data/yt-cache.json. Copy this file to .env.local and fill it in.
YOUTUBE_API_KEY=

# Uploads are stored in your Telegram account. App credentials from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Leave empty to let anyone who can open the site upload; set (6+ characters) to require it.
OWNER_PASSWORD=
