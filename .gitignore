# Dependencies and build output (rebuilt by npm install / npm run build)
node_modules
.next
*.tsbuildinfo

# Secrets: never commit these
.env
.env.*
!.env.example
# Telegram storage: the session in telegram.json can sign in to your Telegram account
data/telegram.json

