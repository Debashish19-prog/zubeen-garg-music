data/library.json
data/colors.json
data/yt-cache.json
data/uploads.json
data/covers/

# Working caches for the YouTube matching scripts (large, rebuilt by the scripts)
data/yt-search-cache.json
data/ytmusic-cache/

# OS files
.DS_Store
